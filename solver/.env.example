# Copy to solver/.env (gitignored: the root .gitignore has `.env`). NEVER commit the real file.
# From Hugo's Alchemy dashboard (D55): app "ANCRE" on Monad mainnet + testnet, one Custom Webhook per network.
ALCHEMY_API_KEY=
# Notify API auth token (dashboard > Webhooks > Auth token): only needed to create/list webhooks by API
ALCHEMY_NOTIFY_TOKEN=
# Signing key of the Custom Webhook (shown on the webhook page): verifies X-Alchemy-Signature
ALCHEMY_SIGNING_KEY=
